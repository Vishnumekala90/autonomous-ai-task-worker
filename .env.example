# Copy to .env and fill in. Never commit .env.

# LLM provider: auto | openai | gemini | scripted
#   auto     -> openai if OPENAI_API_KEY is set, else gemini if GEMINI_API_KEY is set,
#               else "scripted" (deterministic offline stand-in, NOT a real LLM)
LLM_PROVIDER=auto

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: point the OpenAI-compatible client at another endpoint
OPENAI_BASE_URL=

# Gemini is reached through Google's OpenAI-compatible endpoint
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Agent behaviour
APPROVAL_THRESHOLD=100000
MAX_RETRIES=3
MAX_STEPS=30
RETRY_BACKOFF_SECONDS=0.5

# Storage (SQLite file + generated sample invoice documents)
DATABASE_PATH=data/worker.db
INVOICES_DIR=data/invoices

# Demo-only fault injection (lets you trigger simulated failures from API/UI)
ENABLE_FAULT_INJECTION=true

LOG_LEVEL=INFO
